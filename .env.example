# VisualMind Server Environment Variables
# Copy this file to .env and edit values accordingly

PORT=3001
LOG_LEVEL=info

# Upstage AI keys for OCR and LLM
UPSTAGE_API_KEY=

# Storage settings
S3_BUCKET=
AWS_REGION=

# Virus scanning (optional)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Firebase admin service account JSON string
FIREBASE_SERVICE_ACCOUNT=
ADMIN_UIDS=

# Redis for BullMQ queue and cache
REDIS_URL=

# Daily usage quota per user
DAILY_QUOTA=100

# Cluster size (number of worker processes)
CLUSTER=

# Allowed CORS origin (leave empty to allow any)
CORS_ORIGIN=
